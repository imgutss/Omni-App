[Unit]
Description=Omni ShadowQUIC server
Wants=network-online.target
After=network-online.target
[Service]
User=omni-shadowquic
Group=omni-shadowquic
ExecStart=/usr/local/bin/shadowquic -c /etc/omni-shadowquic/server.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
[Install]
WantedBy=multi-user.target
